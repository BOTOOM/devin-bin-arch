# Maintainer: Patrick Fischer <aur@pathin.me>

pkgbase=devin-desktop-bin
pkgname=(devin-desktop-bin{,-electron-latest})
pkgver=3.12.59
pkgrel=1
arch=('x86_64')
url="https://devin.ai/download"
license=('LicenseRef-Devin Desktop')
depends=( ripgrep fd xdg-utils #replacements
    'alsa-lib'
    'dbus'
    'gnupg'
    'libnotify'
    'libsecret'
    'libxkbfile'
    'libxss'
)
optdepends=('glib2: Move to trash functionality'
            'org.freedesktop.secrets: Sync settings'
            'libdbusmenu-glib: KDE global menu'
            'lsof: Terminal splitting'
            'vulkan-driver')
options=('!strip')
makedepends=(tar sed desktop-file-utils binutils)
source=("https://windsurf-stable.codeiumdata.com/linux-x64-deb/stable/0122b42e158c7ca62960222fb9725f087cd9544f/Devin-linux-x64-3.12.59.deb"
		"https://gitlab.archlinux.org/archlinux/packaging/packages/code/-/raw/main/code.sh")
sha256sums=('5857e4cc5bdd0bd734aea40a82638bef6d52ba5fc21e7cf9ab22a1b45ba1f04a'
            '5da1525b5fe804b9192c05e1cbf8d751d852e3717fb2787c7ffe98fd5d93e8c1')
build() {
	# Read the bundled runtime's version without executing the upstream binary.
	tar -xOf data.tar.xz ./usr/share/devin-desktop/devin-desktop \
		| strings \
		| sed -n 's|^Chrome/[0-9.]* Electron/\([0-9][0-9]*\)\.[0-9.]*$|\1|p' \
		| sort -u > electron-major
	ELECTRON_MAJOR=$(cat electron-major)
	if [[ ! "$ELECTRON_MAJOR" =~ ^[0-9]+$ ]]; then
		error "Could not determine a unique Electron major version from the bundled runtime."
		return 1
	fi

	tar -xf "data.tar.xz" --exclude 'usr/share/devin-desktop/[^r]*' --exclude 'usr/share/devin-desktop/*.pak'

	# Ensure metainfo exists and safely move contents from appdata if present
	mkdir -p usr/share/metainfo
	if [ -d usr/share/appdata ]; then
		shopt -s dotglob nullglob
		mv usr/share/appdata/* usr/share/metainfo/ || true
		shopt -u dotglob nullglob
		rmdir usr/share/appdata 2>/dev/null || true
	fi

	# Ensure zsh site-functions exists and safely move completions
	mkdir -p usr/share/zsh/site-functions
	if [ -d usr/share/zsh/vendor-completions ]; then
		shopt -s dotglob nullglob
		mv usr/share/zsh/vendor-completions/* usr/share/zsh/site-functions/ || true
		shopt -u dotglob nullglob
		rmdir usr/share/zsh/vendor-completions 2>/dev/null || true
	fi
	
	# Launcher
	_app=/usr/share/devin-desktop/resources/app
	sed -e "s|code-flags|devin-desktop-flags|" code.sh \
		-e "s|/usr/lib/code/out/cli.js|${_app}/out/cli.js|" \
		-e "s|/usr/lib/code/code.mjs|--app=${_app}|" > run.sh
	ln -sf /usr/bin/devin-desktop usr/share/devin-desktop/devin-desktop
	
	# Replacements
	# Ensure windsurf extension bin path exists for symlinks
	mkdir -p usr/share/devin-desktop/resources/app/extensions/windsurf/bin
	ln -svf /usr/bin/fd usr/share/devin-desktop/resources/app/extensions/windsurf/bin/fd

	# Native binaries live outside the ASAR archive in newer releases.
	RG_DEST_CANDIDATES=(
		"usr/share/devin-desktop/resources/app/node_modules.asar.unpacked/@vscode/ripgrep-universal/bin/linux-x64/rg"
		"usr/share/devin-desktop/resources/app/node_modules.asar.unpacked/@vscode/ripgrep/bin/rg"
		"usr/share/devin-desktop/resources/app/node_modules/@vscode/ripgrep-universal/bin/linux-x64/rg"
		"usr/share/devin-desktop/resources/app/node_modules/@vscode/ripgrep/bin/rg"
	)
	RG_DEST=""
	for rg_dest in "${RG_DEST_CANDIDATES[@]}"; do
		if [ -f "$rg_dest" ]; then
			RG_DEST="$rg_dest"
			break
		fi
	done
	if [ -n "$RG_DEST" ]; then
		ln -svf /usr/bin/rg "$RG_DEST"
	else
		error "Bundled ripgrep binary location not found in known locations; update RG_DEST_CANDIDATES in PKGBUILD."
		return 1
	fi

	if [ -f usr/share/devin-desktop/resources/app/node_modules/open/xdg-open ]; then
		ln -svf /usr/bin/xdg-open usr/share/devin-desktop/resources/app/node_modules/open/xdg-open
	elif [ -f usr/share/devin-desktop/resources/app/node_modules.asar ]; then
		printf '%s\n' "Keeping the bundled open helper inside node_modules.asar."
	else
		error "Neither node_modules/open/xdg-open nor node_modules.asar was found."
		return 1
	fi
	
	# SVG Icon (handle path changes across versions)
	ICON_DEST="usr/share/icons/hicolor/scalable/apps/devin-desktop.svg"
	ICON_CANDIDATES=(
		"usr/share/devin-desktop/resources/app/out/media/code-icon.svg"
		"usr/share/devin-desktop/resources/app/out/media/code-iconsvg.svg"
		"usr/share/devin-desktop/resources/app/out/media/devin-icon.svg"
		"usr/share/devin-desktop/resources/app/out/vs/workbench/browser/media/code-icon.svg"
		"usr/share/devin-desktop/resources/app/out/vs/code/browser/workbench/media/code-icon.svg"
	)
	ICON_FOUND=""
	for icon in "${ICON_CANDIDATES[@]}"; do
		if [ -f "$icon" ]; then
			ICON_FOUND="$icon"
			break
		fi
	done
	if [ -n "$ICON_FOUND" ]; then
		install -Dm644 "$ICON_FOUND" "$ICON_DEST"
	else
		echo "Warning: SVG icon not found in known locations, skipping icon install." >&2
	fi
	
	# Hide entry of URL handler
	URL_HANDLER_CANDIDATES=(
		"usr/share/applications/devin-desktop.UrlHandler.desktop"
		"usr/share/applications/devin-desktop-url-handler.desktop"
	)
	URL_HANDLER_FOUND=""
	for handler in "${URL_HANDLER_CANDIDATES[@]}"; do
		if [ -f "$handler" ]; then
			URL_HANDLER_FOUND="$handler"
			break
		fi
	done
	if [ -z "$URL_HANDLER_FOUND" ]; then
		error "Devin Desktop URL handler desktop file was not found."
		return 1
	fi
	desktop-file-edit --set-key Hidden --set-value true "$URL_HANDLER_FOUND"
}

package_devin-desktop-bin(){
	pkgdesc="Devin Desktop is an agent command center with a full IDE, formerly known as Windsurf."
	cp -r --reflink=auto usr "${pkgdir}/usr"
	_electron="electron$(cat electron-major)"
	echo "$_electron"
	sed "s|name=electron|name=${_electron}|" run.sh > run-safe.sh
	install -Dm755 run-safe.sh "${pkgdir}/usr/bin/devin-desktop"
	ln -sf devin-desktop "${pkgdir}/usr/bin/windsurf"
	depends+=(${_electron}) # hidden from --printsrcinfo
	provides=(devin-desktop windsurf windsurf-bin)
	conflicts=(devin-desktop devin-desktop-bin-electron-latest windsurf windsurf-bin windsurf-bin-electron-latest)
	replaces=(windsurf-bin)
}

package_devin-desktop-bin-electron-latest(){
	pkgdesc="Devin Desktop on latest stable electron"
	mv usr "${pkgdir}/usr" # breaks --repackage
	install -Dm755 run.sh "${pkgdir}/usr/bin/devin-desktop"
	ln -sf devin-desktop "${pkgdir}/usr/bin/windsurf"
	depends+=(electron)
	conflicts=(devin-desktop-bin devin-desktop windsurf-bin windsurf-bin-electron-latest windsurf)
	provides=(devin-desktop-bin devin-desktop windsurf-bin windsurf)
	replaces=(windsurf-bin-electron-latest)
}
